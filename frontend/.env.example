# Public SEO only. Use frontend/.env.production.local or process environment.
# Leave blank before launch: public pages use noindex and robots blocks crawling.
# Set the real HTTPS origin, without a path or port, before a public build.
SEO_SITE_URL=

# Optional verification codes from the actual owner accounts; these are public.
SEO_GOOGLE_SITE_VERIFICATION=
SEO_BING_SITE_VERIFICATION=
SEO_BAIDU_SITE_VERIFICATION=
