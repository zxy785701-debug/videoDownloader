# Copy to project-root .env. Backend reads AI, ASR and access-policy settings at startup.
# Process environment overrides .env; restart backend after editing.
# Alternatively use start-local.ps1 -AskDeepSeekKey for hidden terminal input.
# Never put a real key in this example or a VITE_* variable.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=180
VIDEO_LEARNING_MAX_SECONDS=7200
VIDEO_LEARNING_MAX_CHARACTERS=120000
VIDEO_LEARNING_SUMMARY_TIMEOUT=900
# Explicit opt-in, Bilibili/Douyin captions only; no change to download settings.
# Firefox is read on the machine running Python, never on a remote visitor's PC.
# Keep this 0 on headless cloud servers; unavailable optional sessions fall back.
# Download process-env flags and cloud setup: docs/LOCAL_CLOUD_COOKIE_MODES.md.
# For cloud Bilibili HTML 412, set BILIBILI_METADATA_SOURCE=api in the MAIN
# PROCESS environment, not just this .env. Default webpage keeps local behavior.
# Setup and limitations: docs/BILIBILI_CLOUD_412.md.
VIDEO_LEARNING_FIREFOX_SESSION=0
VIDEO_LEARNING_FIREFOX_PROFILE=

# Exact comma-separated allowlists; setting a value REPLACES the defaults.
# Origins contain scheme + host + optional port, without a trailing slash or path.
# Hostnames/IPs have NO scheme, port, wildcard or path. Never use *.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1
# For SSH tunnel testing, explicitly add http://localhost:8080 to ALLOWED_ORIGINS.
# For HTTPS deployment, use the real https:// domain, exact ALLOWED_HOSTS and true.
# Keep false for local HTTP / SSH HTTP tests. This does not trust forwarded headers.
ACCOUNT_COOKIE_SECURE=false

# Cloud ASR fallback. Project-root .env is server-only and ignored by Git.
# Process environment (including an explicitly empty value) overrides this file.
# Restart the backend after editing. Baota process environment remains supported.
ASR_ENABLED=true
ASR_PROVIDER=aliyun_paraformer
ASR_MODEL=paraformer-v2
ASR_MAX_DURATION_SECONDS=3600
ASR_MAX_CONCURRENT_JOBS=1
ASR_MONTHLY_BUDGET_CNY=10
ASR_STOP_ON_BUDGET=true
ASR_PRICE_CNY_PER_SECOND=0.00008
ASR_USER_HOURLY_LIMIT=3
ASR_JOB_TIMEOUT_SECONDS=1800
ASR_AUDIO_TIMEOUT_SECONDS=900
ASR_POLL_INTERVAL_SECONDS=5
ASR_MAX_RETRIES=2
ASR_MAX_AUDIO_MB=120
ASR_MAX_DOWNLOAD_MB=256
ASR_SIGNED_URL_TTL_SECONDS=7200
ASR_FFMPEG_THREADS=1
# Optional dedicated Beijing workspace endpoint:
ASR_API_BASE=https://dashscope.aliyuncs.com/api/v1
# Optional; default backend/data/asr-tmp (beside VIDEO_LEARNING_DB).
# ASR_TEMP_DIR=
DASHSCOPE_API_KEY=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# Prefer the Alibaba Cloud credential chain / ECS RAM role. Fixed RAM keys are
# optional fallback; never use the root account's AccessKey or any VITE_* key.
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_SECURITY_TOKEN=
