# Copy to project-root .env. Backend reads AI and access-policy settings at startup.
# Process environment overrides .env; restart backend after editing.
# Alternatively use start-local.ps1 -AskDeepSeekKey for hidden terminal input.
# Never put a real key in this example or a VITE_* variable.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=180
VIDEO_LEARNING_MAX_SECONDS=7200
VIDEO_LEARNING_MAX_CHARACTERS=120000
VIDEO_LEARNING_SUMMARY_TIMEOUT=900
# Explicit opt-in, Bilibili/Douyin captions only; no change to download settings.
VIDEO_LEARNING_FIREFOX_SESSION=0
VIDEO_LEARNING_FIREFOX_PROFILE=

# Exact comma-separated allowlists; setting a value REPLACES the defaults.
# Origins contain scheme + host + optional port, without a trailing slash or path.
# Hostnames/IPs have NO scheme, port, wildcard or path. Never use *.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1
# For SSH tunnel testing, explicitly add http://localhost:8080 to ALLOWED_ORIGINS.
# For HTTPS deployment, use the real https:// domain, exact ALLOWED_HOSTS and true.
# Keep false for local HTTP / SSH HTTP tests. This does not trust forwarded headers.
ACCOUNT_COOKIE_SECURE=false
