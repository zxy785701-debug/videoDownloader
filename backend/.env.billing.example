# Copy to backend/.env.billing. Never copy these secrets to frontend or local .env.
BILLING_ENV=development
BILLING_PROVIDER=stripe
BILLING_PUBLIC_URL=http://127.0.0.1:8010
STRIPE_SECRET_KEY=sk_test_replace_locally
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_listen_secret
STRIPE_PRICE_ID=price_replace_with_one_time_1990_cny
# Registration currently skips email verification. Enable later with true.
# Unverified accounts remain unverified in the database; enabling this requires verification.
BILLING_REQUIRE_EMAIL_VERIFICATION=false
# Development without SMTP writes emails into .local/billing-mail (ignored).
# Production requires authenticated STARTTLS SMTP and HTTPS public URL.
BILLING_SMTP_HOST=
BILLING_SMTP_PORT=587
BILLING_SMTP_USER=
BILLING_SMTP_PASSWORD=
BILLING_MAIL_FROM=
